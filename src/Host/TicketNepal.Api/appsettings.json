{
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "" },
  "Cors": { "AllowedOrigins": [] },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Seed": { "AdminEmail": "", "AdminPassword": "" },
  "Frontend": { "BaseUrl": "http://localhost:5173" },
  "Email": { "Provider": "Log" },
  "Resend": { "ApiKey": "", "From": "TicketNepal <onboarding@resend.dev>" },
  "Jwt": {
    "Issuer": "ticketnepal-api",
    "Audience": "ticketnepal-web",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
